{
  "name": "agent-loops",
  "version": "0.1.0",
  "description": "Production-style agent loops (Anthropic SDK + OpenAI SDK) demonstrating drop-in Verlon adoption — change a base URL and one header, route through Verlon.",
  "private": true,
  "type": "module",
  "scripts": {
    "research": "tsx --env-file=.env.local src/agents/research.ts",
    "support": "tsx --env-file=.env.local src/agents/customer-support.ts",
    "extract": "tsx --env-file=.env.local src/agents/doc-extractor.ts",
    "setup-gates": "tsx --env-file=.env.local src/scripts/setup-gates.ts",
    "simulate": "tsx --env-file=.env.local src/scripts/simulate-sessions.ts",
    "simulate-research": "tsx --env-file=.env.local src/scripts/simulate-research-sessions.ts",
    "simulate-extractions": "tsx --env-file=.env.local src/scripts/simulate-extractions.ts",
    "simulate-all": "tsx --env-file=.env.local src/scripts/simulate-all.ts",
    "trigger-ian": "tsx --env-file=.env.local src/scripts/trigger-ian.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "support-v2": "tsx --env-file=.env.local src/agents/support-v2.ts",
    "research-v2": "tsx --env-file=.env.local src/agents/research-v2.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@verlon-ai/sdk": "^2.1.1",
    "openai": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.20.0",
    "typescript": "^5.5.0"
  }
}
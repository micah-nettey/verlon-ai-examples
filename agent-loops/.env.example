# Direct upstream provider keys — used when USE_LAYER is unset/false.
ANTHROPIC_API_KEY=sk-ant-...

# Real Brave Search API key — used by the searcher sub-agent's web_search tool.
BRAVE_API_KEY=BSA...

# Layer drop-in mode — set USE_LAYER=true to route every LLM call through
# Layer instead of hitting Anthropic directly. The agent code itself is
# unchanged; only the SDK init + per-call headers differ.
USE_LAYER=false
LAYER_API_KEY=layer_...
LAYER_API_URL=http://localhost:3001

# When USE_LAYER=true, each LLM call site needs to be mapped to the
# corresponding Layer gate via header. Fill these in after the gates
# exist in your Layer dashboard.
RESEARCH_ORCHESTRATOR_GATE_ID=
RESEARCH_QUICK_ANSWER_GATE_ID=
RESEARCH_SEARCHER_GATE_ID=

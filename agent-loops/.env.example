# Direct upstream provider keys — used when USE_LAYER is unset/false.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Real Brave Search API key — used by the research searcher's web_search tool.
BRAVE_API_KEY=BSA...

# Layer drop-in mode — set USE_LAYER=true to route every LLM call through
# Layer instead of hitting the upstream providers directly. The agent code
# itself is unchanged; only the SDK init + per-call headers differ.
USE_LAYER=false
LAYER_API_KEY=layer_...
LAYER_API_URL=http://localhost:3001

# Per-agent gate IDs. Fill these in by running `pnpm setup-gates`, which
# creates any missing gates and prints the IDs in this exact env-var
# format so you can paste the block back here.

# research agent
RESEARCH_ORCHESTRATOR_GATE_ID=
RESEARCH_QUICK_ANSWER_GATE_ID=
RESEARCH_SEARCHER_GATE_ID=

# customer-support agent — the agent gate itself doubles as classifier
SUPPORT_BILLING_GATE_ID=
SUPPORT_TECHNICAL_GATE_ID=
SUPPORT_GENERAL_GATE_ID=
AGENT_SUPPORT_GATE_ID=

# doc-extractor agent
EXTRACTOR_GATE_ID=
